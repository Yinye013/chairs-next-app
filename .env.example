# NestJS API — authentication (and later orders/payments)
NEXT_PUBLIC_API_URL=

# Sanity CMS — product catalog
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=
NEXT_PUBLIC_SANITY_API_VERSION=

# Write token for scripts/migrate-products.ts ONLY.
# Deliberately un-prefixed: this must never be exposed to the browser.
SANITY_API_WRITE_TOKEN=
